%!PS

%================================================================================
% Test Card Maker main module
%================================================================================

% TV Test Card generator by Raymond Luckhurst, Scriptit Ltd, https://scriptit.uk
% GitHub: https://github.com/scriptituk/tv-test-card-maker
%
% replicates hi-resolution and vector graphics of vintage television test cards
% easily refashioned and customised by CLI parameters and arguments files

/procdict currentdict def
true setpacking % make procs readonly
/tcm-common.ps /ProcSet findresource procdict copy pop
/tcm-init.ps /ProcSet findresource procdict copy pop
/tcm-colour.ps /ProcSet findresource procdict copy pop
/tcm-custom.ps /ProcSet findresource procdict copy pop
/tcm-validate.ps /ProcSet findresource procdict copy pop
/tcm-generic.ps /ProcSet findresource procdict copy pop
/tcm-templates.ps /ProcSet findresource procdict copy pop
/tcm-debug.ps /ProcSet findresource procdict copy pop
false setpacking

100 dict begin % args dict

    initdims initce
    /arguments isdef { % have CLI arguments array
        { arguments { 2 copy validate def } forall } stopped { stop } if
    } if

    /TC /TCF-electronic arg % default pattern
    /TCg group TC get def
    TC cvas (-) cat (-) split dup 0 get cvn /TCp exch def 1 get cvn /TCv exch def
    /args isdef { /args dup load 0 TC put }{ TC } ifelse % set extends=TC
    currentdict exch loadargs pop
    /TCMDEBUGARGS istrue { /TC TC def currentdict pdict } if
    << /PageSize [ TCw TCh ] /ImagingBBox null >> setpagedevice
%   true setstrokeadjust

    /TC? isdef not { /TC? true def } if % false for no TC elements or watermark (CEs only)
    {
        /Blank peq { exit } if % blank canvas
        TC? not { exit } if % no elements painted
        null geq { % no group
            (tcm-pattern-) TCp cvas (.ps) cat cat cvn /ProcSet % pattern
        }{ % in group
            (tcm-group-) TCg cvas (.ps) cat cat cvn /ProcSet % group
        } ifelse
        2 copy resourcestatus {
            pop pop findresource currentdict copy pop
            make
            exit
        } if
        pop /undefinedresource signalerror exit
    } loop
    X? TC? and { Extra } if
    CustomElements
    X? TC? and /Blank geq not and Xwt null ne and { Watermark } if

end

showpage

count 0 ne { (EOF)= pstack } if

