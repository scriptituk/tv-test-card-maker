%================================================================================
% Test Card Maker debugging module
%================================================================================
100 dict begin

% graphics

/crosshairs {
    gsave 1 setlinewidth cyan
    moveto currentpoint hGlw 0 rmoveto Gsz hGlw sub 0 rlineto
    moveto currentpoint hGlw neg 0 rmoveto hGlw Gsz sub 0 rlineto
    moveto currentpoint 0 hGlw rmoveto 0 Gsz hGlw sub rlineto
    moveto 0 hGlw neg rmoveto 0 hGlw Gsz sub rlineto
    stroke grestore
} bind def

% Introspection

/grwx { % check object access
    dup dup gcheck { 8 }{ 0 } ifelse exch xcheck { 1 or } if
    1 index type false [/arraytype /packedarraytype /dicttype /filetype /stringtype] {
        2 index eq or
    } forall
    exch pop {
        1 index wcheck { 2 or } if
        1 index rcheck { 4 or } if
    }{
        4 or
    } ifelse
    exch pop
} bind def

/isr { % check read access
    grwx 4 and 0 ne
} bind def

/pvars { ] { dup load == == } forall (-vars-) = } bind def

/cvts { % convert any to token string or -type-
    dup type { % case stmt
        dup /stringtype eq { pop (\() exch (\)) cat cat exit } if
        dup /nametype eq { pop (/) exch dup length string cvs cat exit } if
        dup /integertype eq { pop 20 string cvs exit } if % -9223372036854775807
        dup /realtype eq { pop 20 string cvs exit } if
        dup /booleantype eq { pop 5 string cvs exit } if
        dup /nulltype eq { pop pop (null) exit } if
        exch pop dup length string cvs 0 1 index length 4 sub getinterval (-) exch (-) cat cat exit
    } loop
} bind def

/pdict { % dump dictionary
    dup keys {cvas tolower exch cvas tolower exch} insertionsort {
        2 copy get exch $===++ === ( ) print $===-- ===
    } forall pop
    (-pdict-) =
} bind def

userdict /$=== 0 put
userdict /$===++ { /$=== $=== 1 add store } bind put
userdict /$===-- { /$=== $=== 1 sub store } bind put
/=== { % dump object (improved ==)
    dup type { % case stmt
        1 index isr not { cvts print pop exit } if % no read
        dup /dicttype eq {
            pop
            $===++
            ( >>) (<<) print exch
            dup {
                exch ( ) print === ( ) print
                dup isr {
                    2 copy ne { === }{ pop (-this-) print } ifelse % no recurse
                }{
                    === % no read
                } ifelse
            } forall pop
            print
            $===--
            exit
        } if
        dup /arraytype eq 1 index /packedarraytype eq or {
            pop
            dup xcheck {
                ( }) ({) print exch
                { ( ) print cvts print } forall
            }{
                $===++
                ( ]) ([) print exch
                { ( ) print === } forall
                $===--
            } ifelse
            print
            exit
        } if
        pop cvts print exit % tokenise
    } loop
    $=== 0 eq { (\n) print } if
    flush
} bind def

currentdict end
%================================================================================
/tcm-debug.ps exch /ProcSet defineresource

