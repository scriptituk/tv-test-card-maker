%================================================================================
% Test Card Maker debugging module
%================================================================================
100 dict begin

/pdict {
    dup keys {cvas tolower exch cvas tolower exch} insertionsort {
        2 copy get exch /$=== 1 def === ( ) print /$=== 0 def ===
    } forall pop
    (-pdict-) =
} bind def

/pvars { ] { dup load == == } forall (-vars-) = } bind def

/crosshairs {
    gsave 1 setlinewidth cyan
    moveto currentpoint hGlw 0 rmoveto Gsz hGlw sub 0 rlineto
    moveto currentpoint hGlw neg 0 rmoveto hGlw Gsz sub 0 rlineto
    moveto currentpoint 0 hGlw rmoveto 0 Gsz hGlw sub rlineto
    moveto 0 hGlw neg rmoveto 0 hGlw Gsz sub rlineto
    stroke grestore
} bind def

userdict /$=== 0 put
/===inc { userdict /$=== 2 copy get 1 add put } bind def
/===dec { userdict /$=== 2 copy get 1 sub put } bind def
/===0eq { userdict /$=== get 0 eq } bind def
/=== { % improved ==
    dup type { % case stmt
        dup /dicttype eq {
            pop
            (<<) print
            ===inc
            { exch ( ) print === ( ) print === } forall
            ===dec
            ( >>) print
            exit
        } if
        dup /arraytype eq 1 index /packedarraytype eq or {
            pop
            dup xcheck { (}) ({) }{ (]) ([) } ifelse print exch
            ===inc
            { ( ) print === } forall
            ===dec
            ( ) print print
            exit
        } if
        dup /stringtype eq { pop (\() print print (\)) print exit } if
        dup /nametype eq { pop (/) print cvas print exit } if
        dup /integertype eq { pop cvas print exit } if
        dup /realtype eq { pop cvas print exit } if
        dup /booleantype eq { pop cvas print exit } if
        dup /nulltype eq { pop pop (null) print exit } if
        cvas 0 1 index length 4 sub getinterval (-) print print (-) print pop exit % show type
    } loop
    ===0eq { (\n) print } if
    flush
} bind def

currentdict end
%================================================================================
/tcm-debug.ps exch /ProcSet defineresource

