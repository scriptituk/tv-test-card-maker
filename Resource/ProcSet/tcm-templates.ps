%================================================================================
% Test Card Maker templates module
%================================================================================
100 dict begin

/Blank { null % extends nothing

% custom shape S0 defaults
CustomShape { exch cvas 1 1 getinterval (S0) exch cat exch def } forall

% custom image I0 defaults
CustomImage { exch cvas 1 1 getinterval (I0) exch cat exch def } forall

% custom text T0 defaults
CustomText { exch cvas 1 1 getinterval (T0) exch cat exch def } forall

% extra processing
/Xsp {} arg % supplementary rendering procedures
/Xwt /T-9 arg % watermark text element name, null for no watermark
/X? true arg % false for no extra processing

% watermark text
/T-9s (r) arg
/T-9f /eos-icons--replica arg
/T-9c 0.5 arg
/T-9y TCh 50 div arg
/T-9x TCw T-9y sub arg
/T-9h 1.6 T-9y mul arg % show in bottom-left 1/25th of height
/T-9a /C arg

} def

%================================================================================

/TCA { /Blank % extends

405t

% validator overrides
/=Gszv { isnumber } bind def
/=FBc { iscolour } bind def
/=NPc { iscolour } bind def
/=SBc { iscolour } bind def

/TCbc /white arg
/Gszv TCh 16.5 div arg % vertical grid size
/Gsz TCw 20.5 div 1.1 Gszv mul min 0.9 Gszv mul max arg
/SBiw 3 xGsz arg
/SBih 0.51 xGsz arg
/SBy TCy 4.44 xGsz sub arg
/SBc /black arg
/CClw 0.74 xGsz arg
/CCr 2.6 xGsz arg
/IDs (A) arg
/IDf /GillSans-alt arg
/IDc /black arg
/IDh 0.89 xGsz arg
/IDx TCx arg
/IDy TCy 5.51 xGsz sub arg
/FBh SBiw arg
/FBc /black arg
/FBx TCx 4.81 xGsz sub arg
% freq bars array: MHz, nbars, x-multiplier, custom text element name, y-multiplier
/FBf [ [1 6 -1 /T-2 1] [1.5 6 1 /T-3 1] [2 6 -1 /T-4 -1] [2.5 6 0 /T-1 0] [3 6 1 /T-5 -1] ] arg
/NPh FBh arg
/NPx TCx 5.91 xGsz sub arg
/NPc /black arg
/Bw 0.53 xGsz arg

% frequency text
/T-1s (     MC) arg % (units)
/T-1f /GillSans-alt arg
/T-1h 0.53 xGsz arg
/T-1x TCx arg
/T-1t 0.1 arg
/T-1w -0.95 arg
/T-1 /T0 merge

/T-2s ( MC) arg
/T-2x FBx 1.95 xGsz sub arg
/T-2t 0.05 arg
/T-2 /T-1 merge

/T-3x TCw T-2x sub arg
/T-3w -0.9 arg
/T-3 /T-2 merge

/T-4 /T-2 merge

/T-5x TCw FBx sub 1.85 xGsz add arg
/T-5t 0.15 arg
/T-5 /T-4 merge

} def

%================================================================================

/TCC-early { /Blank % extends

405t

% test card
/TCbc 0.6 arg % background colour
% graticule
/Gsz TCh 0.129 mul arg % grid size: datum for all measurements
/Glw Gsz 12 div arg % grid linewidth
/Golw 0 arg % grid outline width: 0 for no outline (F/J/W/X pattern)
/Gps? false arg % true to shift grid phase by half a square
/Glc /white arg % grid line colour
/G? true arg % false for no graticule
% streak box
/SBow 2.66 xGsz arg % streak box outer width
/SBoh 0.89 xGsz arg % streak box outer height
/SBiw 1.75 xGsz arg % streak box inner width
/SBih 0.31 xGsz arg % streak box inner height
/SBy TCy 2.81 xGsz add arg % streak box vertical centre
/SBc [/black /white] arg % streak box colours: [inner outer]
/SB? true arg % false for no streak box
% pulse panes (left)
/PPw 2 xGsz Glw add arg % pulse pane width
/PPh 3 xGsz Glw add arg % pulse pane height
/PPx TCx 2 xGsz sub arg % pulse pane horizontal centre
/PPc [/black /white] arg % pulse pane colours: [left right]
/PP? true arg % false for no pulse panes or needle pulse lines
% needle pulse lines (left)
/NPw 0.25 us arg % needle pulse linewidth
/NPh 1.8 xGsz arg % needle pulse line height
/NPx PPx 0.725 xGsz sub arg % needle pulse line horizontal centre
% ident designation
/IDs (C) arg % ident string: empty for no ident
/IDf /GillSans arg % ident font
/IDc /white arg % ident colour
/IDh 0.63 xGsz arg % ident height
/IDx TCx 0.07 xGsz sub arg % ident horizontal centre
/IDy TCy 3 xGsz sub arg % ident vertical centre
/IDdr 0 arg % ident adjacent dot radius: 0 for none
% caption (clipped)
/Ct [] arg % caption custom text element names: empty for no caption
/Cy TCy 3 xGsz sub arg % caption vertical centre
/Cr 1 arg % caption rectangle graticule rows
/Cc 2 arg % caption rectangle graticule columns
/Cch 1 arg % caption rectangle clip height scale factor
% centre circles
/CCf? true arg % false for no fill (empty)
/CClw 0.1 xGsz arg % centre circles stroke width
/CCr 2 xGsz arg % white circle stroke radius
/CCbr CCr CClw add arg % black circle stroke radius: 0 for none
/CCor CCr CClw mul2 add arg % outer circle stroke radius: 0 for none
/CC? true arg % false for no circles
% centre picture
/CPi null arg % picture custom image element name, null for no image
% step wedge
/SWx TCx arg % step wedge horizontal centre
/SWw 0.5 xGsz arg % step wedge width
/SWoh 2.5 xGsz arg % step wedge outer height
/SWc [0 0.3 0.5 0.7 1] arg % step wedge colours: [bottom to top]
/SWds 0 arg % step wedge dot size 0 for none, diameter or [width height] array
/SWdc [0.2 1] arg % step wedge dot colours: [bottom top]
/SW? true arg % false for no step wedge
% frequency bars (left)
/FB2? true arg % true for 2 bars, false for 1
/FBoh PPh arg % freq bar outer height
/FBow SWw arg % freq bar outer width
/FBh 0.505 xGsz arg % freq bars height
/FBg 0 arg % freq bars gap size (>0 for D/E)
/FBp 0.012 xGsz arg % freq bars padding
/FBc [0 1 1] arg % freq bars colours: [min max surround]
/FBs? false arg % true for sinusoidal frequency gratings, false for square
/FBx TCx 1.21 xGsz sub FBow div2 add arg % freq bars horizontal centre
/FBf [ [1 4 0] [1.5 6 0] [2 8 0] [2.5 10 0] [3 12 0] ] arg % frequencies: [MHz nbars antiphase] array
/FBt null arg % custom text element name for freq text template, null for no text
/FB? true arg % false for no frequency bars
% corner stripes (bottom-left)
/CSa 1 TCr atan arg % corner stripes angle from horizontal
/CSol 3.03 xGsz arg % corner stripes outer length from corner
/CSow Gsz arg % corner stripes outer width
/CShf 0.9 arg % corner stripes horizontal fundamental MHz
/CSlw CShf mhz div2 1 TCar atan sin mul arg % corner stripes linewidth at normal aspect ratio
/CSnl 10 arg % corner stripes number of lines
/CSep Glw arg % corner stripes end padding
/CSbp Glw arg % corner stripes border padding (clipped)
/CSc [/black /white] arg % corner stripes colours: [grating surround]
/CS? true arg % false for no corner stripes
% colour bar
/CBh 0 arg % colour bar height: 0 for no colour bars (fraction of border width)
/CBc [] arg % colour bar colours: [left to right]
/CBew 0 arg % colour bar end widths (fraction of uniform inner widths)
% border
/Bw 0.26 xGsz arg % border width
/Bah 0 arg % border arrow height (fraction of border width, 0 for no arrows)
/Bac [1 0] arg % border arrow colours: [horizontal vertical]
/Bcc [] arg % castellation colours: empty or [left-red left-blue bottom-green right-yellow top-cyan]
/B? true arg % false for no drawn border

} def

%================================================================================

/TCC { /TCC-early % extends

/Gsz TCh 0.129 mul arg
/SBih 0.28 xGsz arg
/IDf /TCM-BBC_C-SemiBold arg
/IDh 0.69 xGsz arg
/IDx TCx 0.02 xGsz sub arg
/Ct [/T-1] arg
/SWoh 2.55 xGsz arg
/SWw 0.52 xGsz arg
/NPx PPx 0.7 xGsz sub arg
/CCor CCr CClw 1.9 mul add arg
/FBh 0.53 xGsz arg
/FBp 0.02 xGsz arg
/CSol 3.08 xGsz arg
/Bw 0.29 xGsz arg
/Bah 0.5 arg

% caption text
/T-1s (BBC) arg
/T-1f /Courier-Bold arg
/T-1c 0 arg
/T-1h 0.41 xGsz arg
/T-1x TCx 0.06 xGsz add arg
/T-1y Cy arg
/T-1w 1.35 xGsz arg
/T-1t 0.6 arg
/T-1 /T0 merge

} def

%================================================================================

/TCC-625 { /TCC % extends

625t

/TCbc 0.53 arg
/Gsz TCh 7.79 div arg
/Glw Gsz 12 div arg
/SBy TCy 2.8 xGsz add arg
/SBoh 0.89 xGsz arg
/SBow 2.68 xGsz arg
/NPx TCx 2.74 xGsz sub arg
/NPw 0.2 us arg
/IDs () arg
/Cc 7 arg
/Ct [/T-3 /T-4] arg
/CClw 0.12 xGsz arg
/CCr 2.01 xGsz arg
/CCbr CCr CClw add arg
/CCor CCr CClw 1.8 mul add arg
/SWoh 2.67 xGsz arg
/SWw 0.535 xGsz arg
/SWc [0 0.33 0.5 0.8 1] arg
/FBow 0.6 xGsz arg
/FBh 0.525 xGsz arg
/FBg 0 arg
/FBp 0.023 xGsz arg
/FBoh 3 xGsz Glw add arg
/FBx TCx 1.27 xGsz sub FBow div2 add arg
/FBf [ [1.5 4 0] [2.5 7 0] [3.75 10 0] [4.5 12 0] [5.25 14 0] ] arg
/FBt /T-1 arg
/CSol 3.11 xGsz arg
/CShf 1.3 arg
/Bw 0.29 xGsz arg
/Bah 1 arg
/Xsp { Mcs } arg

% frequency text
/T-1s (0123456789) arg % supplied by proc
/T-1f /Helvetica-Bold arg
/T-1h FBh 0.3 mul arg
/T-1w -0.9 arg
/T-1x FBx FBow div2 add TCx SWw div2 sub add div2 arg
/T-1c 0 arg
/T-1 /T0 merge

% Mc/s text
/T-2s (Mc/s) arg
/T-2x TCx arg
/T-2y TCy SWoh 0.56 mul add arg
/T-2 /T-1 merge
/Mcs { /T-2 ceargs customtext } def

% caption text
/T-3s (BBC 2) arg
/T-3f /DerekATItalic arg
/T-3c 0 arg
/T-3w 2.39 xGsz arg
/T-3h 0.46 xGsz arg
/T-3b true arg
/T-3m /C arg
/T-3a /R arg
/T-3x TCx 0.15 xGsz sub arg
/T-3y TCy 3 xGsz sub arg
/T-3t 0.13 arg
/T-3g 0.45 arg
/T-3p 0.13 arg
/T-3o 1.6 arg
/T-3- true arg
/T-3 /T0 merge
/T-4s (625 LINES) arg
/T-4f /Helvetica-Narrow arg
/T-4w 2.47 xGsz arg
/T-4a /L arg
/T-4x TCx 0.18 xGsz add arg
/T-4t 0.02 arg
/T-4b false arg
/T-4 /T-3 merge

} def

%================================================================================

