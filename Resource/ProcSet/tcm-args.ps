
/args { null % leave this line intact

% Put args here: /name expr arg
% where: name must follow a forward-slash
%        expr must evaluate to a single value
%        arg is the literal word 'arg'
% Examples:
% /TCbc /blue arg % background colour name
% /Ct [/T10] arg % caption is custom text element 10
% /T10s (Hello World) arg % caption text string
% /T10h 0.5 xGsz arg % caption height = half a grid square
% /T10y Cy arg % caption vertical centre = default
% /T10c /cyan arg % caption colour name
% /T10b true arg % caption has block-inverted characters
% /T10t 0.2 arg % caption tracking (fraction of height)
% /T10r 0.1 arg % caption corner radius (fraction of height)

} def % leave this line intact
